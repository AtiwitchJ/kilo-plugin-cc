{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kilo Review Output",
  "type": "object",
  "required": ["summary", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "approve-with-comments", "request-changes", "needs-discussion"]
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph high-level summary of the review."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "severity", "body"],
        "properties": {
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["blocking", "major", "minor", "nit", "praise"]
          },
          "body": { "type": "string" },
          "location": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" }
            }
          }
        }
      }
    },
    "details": { "type": "string" },
    "nextSteps": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}